# DocC generated output
/docs-output/
/docc-output/
# `docc preview` builds INTO the catalog it is serving, so this lands under
# Sources/ where nothing else does. Ignored by name rather than by path, since
# a second catalog would do the same.
.docc-build/

# Profiling: raw Instruments traces are large (~14 MB each) and are NEVER
# committed — the profiling record lives in commit messages (see CLAUDE.md).
/profiling-traces/
*.trace
# Frame dumps the example app writes on exit (one per Mode-B record run).
tuikit-frame*.ansi
__pycache__/
# ordo-one/benchmark stores baselines here; local + machine-specific.
/.benchmarkBaselines/

# Docs site (Astro)
docs/node_modules/
docs/.astro/
docs/dist/
docs/.env.local
docs/project-stats.json

# Claude Code
img/
logo-prompt.md
session-*.md
*.backup

# AI tooling / local caches (per-developer)
.claude/*
!.claude/plans/
!.claude/CLAUDE.md
!.claude/openspec/
.cursor/
.serena/
.vscode/
.windsurfrules
AGENTS.md
WHATS-NEXT.md

# Local tooling
papers/
.gource/
.remember

# Terminal-probe default outputs (Tools/TerminalProbes — run from anywhere).
# Every probe that takes PROBE_OUT is listed, not only the three whose output
# somebody happened to trip over: a probe is RUN IN THE TERMINAL UNDER TEST,
# which means it is usually run from the repo root by a person following the
# README, and its result is a measurement to read and transcribe into
# Documentation/ rather than a file to commit.
mouse_probe*.log
advance_probe*.json
background_probe*.json
cell_aspect_probe*.json
graphics_probe*.json
hyperlink_probe*.json
identity_probe*.json
landing_probe*.json
matrix_probe*.json
mouse_probe*.json
page_clusters_probe*.json
palette_probe*.json
placement_probe*.json
recent_emoji_sweep*.json
treatment_card*.json

# The WebAssembly demo's build products (Tools/Web/build.sh makes them).
# The module is ~50 MB and the resources are copies of what SwiftPM already
# built, so none of it belongs in the history — see Tools/Web/README.md.
Tools/Web/site/Example.wasm
Tools/Web/site/manifest.json
Tools/Web/site/resources/
